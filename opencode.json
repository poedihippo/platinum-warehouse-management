{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "AGENTS.md",
        "PRD.md"
    ],
    "mcp": {
        "mysql": {
            "type": "local",
            "command": ["npx", "-y", "@benborla29/mcp-server-mysql"],
            "enabled": true,
            "environment": {
                "MYSQL_HOST": "127.0.0.1",
                "MYSQL_PORT": "3306",
                "MYSQL_USER": "root",
                "MYSQL_PASS": "password",
                "MYSQL_DB": "platinum_event"
            }
        },
        "sequential-thinking": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "enabled": true
        },
        "memory": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-memory"
            ],
            "enabled": true
        },
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp"
            ],
            "enabled": true
        }
    },
    "lsp": {
        "php": {
            "command": [
                "/home/nikko/.config/composer/vendor/bin/phpactor",
                "language-server"
            ],
            "extensions": [
                ".php"
            ]
        }
    },
    "formatter": {
        "php": {
            "command": [
                "./vendor/bin/pint",
                "--fix"
            ],
            "extensions": [
                ".php"
            ]
        }
    },
    "skills": {
        "paths": [
            ".opencode/skills"
        ]
    },
    "permission": {
        "bash": {
            "php *": "allow",
            "./vendor/bin/pint *": "allow",
            "composer *": "ask",
            "php artisan *": "ask",
            "npm *": "ask",
            "git *": "ask",
            "*": "ask"
        }
    }
}
